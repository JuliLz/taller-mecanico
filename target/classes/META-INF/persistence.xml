<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.1" xmlns="http://xmlns.jcp.org/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_1.xsd">
  <persistence-unit name="testJPAPersistenceUnit" transaction-type="RESOURCE_LOCAL">
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
    <class>com.mycompany.mavenproject.logica.Mecanico</class>
    <class>com.mycompany.mavenproject.logica.ServicioMecanico</class>
    <class>com.mycompany.mavenproject.logica.TipoServicio</class>
    <class>com.mycompany.mavenproject.logica.Cliente</class>
    <class>com.mycompany.mavenproject.logica.Auto</class>
    <properties>
      <property name="javax.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/taller_mecanico?serverTimezone=UTC&amp;useSSL=false&amp;allowPublicKeyRetrieval=true"/>
      <property name="javax.persistence.jdbc.user" value="root"/>
      <property name="javax.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
      <property name="javax.persistence.jdbc.password" value=""/>
      <!-- El esquema ya fue creado; no se vuelven a generar claves foráneas al abrir ventanas. -->
      <property name="eclipselink.ddl-generation" value="none"/>
    </properties>
  </persistence-unit>
</persistence>
